# Paystack live credentials for backend/frontend checkout flows.
# IMPORTANT: keep the SECRET_KEY only in the live backend deployment environment,
# not in the repo or frontend bundle.
PAYSTACK_SECRET_KEY=YOUR_PAYSTACK_SECRET_KEY
PAYSTACK_PUBLIC_KEY=pk_live_15b415df90f55aed4082c964b0fcb61daa642d41
VITE_PAYSTACK_PUBLIC_KEY=pk_live_15b415df90f55aed4082c964b0fcb61daa642d41
