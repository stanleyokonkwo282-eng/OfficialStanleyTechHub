# ImageKit PUBLIC key — REQUIRED for image uploads (certificate designs,
# course thumbnails, etc.). Safe to expose in the browser.
# Get it from your ImageKit dashboard if the value below is stale.
VITE_IMAGEKIT_PUBLIC_KEY=public_D8Ael8MK3U2LxGKzmYwsvaOPzuQ=

# Admin notifications (exam completion) are sent by the BACKEND.
# Configure these as secret env vars on Render/Vercel — never in the client:
#   ADMIN_EMAIL, ADMIN_WHATSAPP, SMTP_HOST/PORT/USER/PASS,
#   TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_WHATSAPP_FROM
